# Salesforce Test Credentials - DO NOT COMMIT REAL VALUES
# Copy this file to .env and fill in with your actual credentials
# .env is added to .gitignore and should never be committed

# Salesforce login credentials (for valid login test)
SF_USERNAME=your-test-user@example.com
SF_PASSWORD=your-test-password

# Salesforce reset email (for password reset test)
SF_RESET_USERNAME=your-test-user@example.com

# Optional: Salesforce environment
# SF_BASE_URL=https://test.salesforce.com
